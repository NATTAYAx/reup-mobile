<?xml version="1.0" encoding="utf-8"?>
<!--
  Over a picture, under the words: dark enough at the top for the clock and at
  the bottom for the lists, a little lighter between, so the picture is still
  the picture. Pictures people pick for a home screen are often bright, and
  whatever the picture is, the words are white on at least this.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_radius" />
    <gradient
        android:angle="270"
        android:centerColor="#66000000"
        android:endColor="#A6000000"
        android:startColor="#8C000000" />
</shape>
