<?xml version="1.0" encoding="utf-8"?>
<!--
  The button on the corner of a note on dark paper: dark, with a faint light
  ring, so it belongs to the paper rather than sitting on it like a sticker.
  The tick in it is tinted with the note's own ink.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#F21F2433" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
