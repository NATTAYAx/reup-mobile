<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_panel.xml for a card with a picture on it. A pane of light on a bright
  picture makes it brighter still, and the words in it harder to read; this
  one darkens what is behind it instead.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_inner_radius" />
    <solid android:color="#59000000" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
