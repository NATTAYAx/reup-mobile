<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's shape and nothing else: the root's background, so the root can
  clip everything inside it to the card's corners (clipToOutline, Android 12
  and up). Transparent, so the card's own edge is the only one drawn.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_radius" />
    <solid android:color="@android:color/transparent" />
</shape>
