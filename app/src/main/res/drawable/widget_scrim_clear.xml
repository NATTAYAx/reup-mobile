<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_scrim.xml for a widget with no background of its own, over the
  wallpaper: lighter, so what plays behind it is still the thing seen, and
  darkest at the top and the bottom, where the clock and the lists are. The
  card in the middle brings its own dark pane (widget_panel_dark.xml).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_radius" />
    <gradient
        android:angle="270"
        android:centerColor="#1F000000"
        android:endColor="#73000000"
        android:startColor="#59000000" />
</shape>
