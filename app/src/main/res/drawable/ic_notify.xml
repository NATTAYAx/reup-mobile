<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark again, at the size the status bar draws it.

  WHY IT IS A SEPARATE FILE FROM THE LAUNCHER ICON

  Not laziness about reuse. A notification icon is a stencil: Android throws
  away every colour in it and keeps only the alpha, then tints the shape white
  or grey to match whatever the status bar is doing. So the launcher icon's
  violet square would arrive as a solid block, and the white ring inside it
  would be invisible because it is a hole in nothing.

  It is also drawn much smaller. The launcher artwork is a ring 52 units across
  on a 108 canvas; the same proportions at 24 units give a stroke under one
  pixel on most phones, which disappears. This one is redrawn for its size
  rather than scaled down to it.

  The shape is the same idea: an open ring with the dot sitting in its gap.

    ring   centre 12,12   radius 7.5   stroke 2.4   gap 70 degrees, at the top
    dot    centre 12,4.5  radius 2
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M16.30,5.86 A7.5,7.5 0 1 1 7.70,5.86"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M10,4.5 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#FFFFFF" />
</vector>