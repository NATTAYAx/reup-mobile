<?xml version="1.0" encoding="utf-8"?>
<!--
  The round button on a note's corner that takes it off. White with a faint
  ring in the notes' ink, so it reads on every paper and over every picture.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#F5FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#402A2633" />
</shape>
