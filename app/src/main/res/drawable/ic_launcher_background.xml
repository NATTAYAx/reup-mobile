<?xml version="1.0" encoding="utf-8"?>
<!--
  The page behind the mark.

  Flat, and the app's violet rather than the page's near-black. A launcher puts
  this next to thirty other icons on somebody's wallpaper, where a dark square
  reads as a hole. Inside the app the violet is the colour of the one thing the
  screen is for; out here it is the whole of it.

  It is #7C3AED, the same value as Palette.violet.primary and as the desktop's
  theme.ts. The icon does not follow the theme picker: an icon that changes
  colour is an icon you have to look for twice, and the launcher caches it
  anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#7C3AED"
        android:pathData="M0,0h108v108h-108z" />
</vector>