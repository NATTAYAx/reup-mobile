<?xml version="1.0" encoding="utf-8"?>
<!--
  Four by two: the clock and the day's bar on the left, what is next and
  the rounds after it on the right. Also the preview in the home screen's
  widget list, which is why its words have something in them before the app
  has drawn it. See widget_small.xml for the layers behind the words.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <ImageView
        android:id="@+id/w_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/w_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow" />

    <ImageView
        android:id="@+id/w_glow_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow_end" />

    <ImageView
        android:id="@+id/w_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim"
        android:visibility="gone" />

    <!-- The light. A progress bar because that is what a widget may animate; see widget_shine.xml. -->
    <ProgressBar
        android:id="@+id/w_shine"
        style="@android:style/Widget.ProgressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/widget_shine"
        android:maxWidth="4000dp"
        android:maxHeight="4000dp"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/w_clock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="#E8E8EA"
                    android:textSize="36sp" />

                <ImageView
                    android:id="@+id/w_moon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="ช่วงเงียบ"
                    android:src="@drawable/ic_moon"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/w_wait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/w_wait_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_wallet" />

                    <TextView
                        android:id="@+id/w_wait_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#A78BFA"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/w_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#59000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="วันนี้"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <!-- Room, pushed to the bottom. A FrameLayout: a widget may not hold a plain View or a Space. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/w_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/w_bar"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track" />

                    <ImageView
                        android:id="@+id/w_bar_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill" />
                </FrameLayout>

                <TextView
                    android:id="@+id/w_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:shadowColor="#59000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="ทำแล้ว 2/5"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1.25"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/w_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/widget_panel"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/w_head_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ถัดไป"
                    android:textColor="#A78BFA"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/w_head_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="#59000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="งานถัดไป"
                        android:textColor="#E8E8EA"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/w_head_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="18:00"
                        android:textColor="#A78BFA"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_soon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
