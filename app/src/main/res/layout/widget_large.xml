<?xml version="1.0" encoding="utf-8"?>
<!--
  Four by four, or anything at least that tall, laid out the way the desktop's
  board is: the clock, the date, the notes stuck on it, what is next in large
  type with its time under it, and then one list - the rest of the day under a
  heading per day, the day's bar, the longer rounds, the month's money - with
  the time in its own column and the name after it.

  The list is a ListView from Android 12, filled with the rows themselves
  (ReupWidget.list), so it takes exactly the height the home screen gives
  it rather than a height worked out beforehand: a home screen that says the
  widget is shorter than it is no longer leaves the bottom third empty, and one
  that is too short fades the last row out instead of cutting it in half.
  Before Android 12, w_rows takes a counted number of the same rows.

  See widget_small.xml for the layers behind the words.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <ImageView
        android:id="@+id/w_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!--
      Where the film goes, when there is one: see widget_film.xml. A stub until
      then, because a flipper keeps its timer running whether or not it has
      anything to show, and a widget without a film should not tick.
    -->
    <ViewStub
        android:id="@+id/w_film_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/w_film"
        android:layout="@layout/widget_film" />

    <ImageView
        android:id="@+id/w_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow" />

    <ImageView
        android:id="@+id/w_glow_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow_end" />

    <ImageView
        android:id="@+id/w_veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_veil"
        android:visibility="gone" />

    <!-- The light. A progress bar because that is what a widget may animate; see widget_shine.xml. -->
    <ProgressBar
        android:id="@+id/w_shine"
        style="@android:style/Widget.ProgressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/widget_shine"
        android:maxWidth="4000dp"
        android:maxHeight="4000dp"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/w_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:shadowColor="#4D000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="46sp" />

            <!-- Room, pushed between. A FrameLayout: a widget may not hold a plain View or a Space. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/w_moon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="ช่วงเงียบ"
                android:src="@drawable/ic_moon"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w_wait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/w_wait_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wallet" />

                <TextView
                    android:id="@+id/w_wait_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/w_add"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_add_light"
                android:contentDescription="แปะโน้ต"
                android:padding="8dp"
                android:src="@drawable/ic_note_add" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="วันนี้"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- The notes, as ReupWidget.notes adds them: widget_note.xml each, and widget_more.xml after. -->
        <LinearLayout
            android:id="@+id/w_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-7dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/w_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_head_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="ถัดไป"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_head_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#4D000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="งานถัดไป"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_head_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:shadowColor="#40000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="18:00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/w_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdgeLength="28dp"
                android:listSelector="@android:color/transparent"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/w_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
